<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash (owner, 2026-10-23): the still mark itself,
         without a tile, on the first screen's background (splash_mark_*.xml,
         generated by tool/culmina_mark.py). It leaves at Flutter's first
         frame, which draws the same mark in the same place; Flutter then
         plays the whole launch gesture (LaunchGate) before the app opens. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark_light</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- Android 13+: the app's own appearance and field mode, which the
         system cannot know at launch. MainActivity stores the matching one
         with SplashScreen.setSplashScreenTheme when they change, so the next
         launch's splash is already right (no bright splash before field
         mode). "System" resets to LaunchTheme above. -->
    <style name="CulminaSplash.Light" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark_light</item>
    </style>
    <style name="CulminaSplash.Dark" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#191919</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark_dark</item>
    </style>
    <style name="CulminaSplash.Field" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background_field</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark_field</item>
    </style>
</resources>
