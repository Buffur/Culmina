<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window on the dark surface: its background and the
     still mark, centred at the launch size, exactly where the splash icon
     and the Flutter launch screen draw it. The splash before Android 12,
     and the window behind Flutter at every launch, so no frame between
     the splash and Flutter can show the background without the mark.
     Generated by tool/culmina_mark.py; edit the tool, not this file. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#191919" />
    </item>
    <item
        android:drawable="@drawable/launch_mark_dark"
        android:gravity="center" />
</layer-list>
