+class GainPainter extends CustomPainter {
+  const GainPainter(this.color);
+  final Color color;
+  @override
+  void paint(Canvas canvas,Size size) {
+    final c=color;
+    final paint=Paint()..color=c..strokeWidth=1.5..style=PaintingStyle.stroke;
+    final l=35.0;final b=size.height-35;final w=size.width-l-12;final h=b-12;
+    canvas.drawLine(Offset(l,10),Offset(l,b),paint);canvas.drawLine(Offset(l,b),Offset(l+w,b),paint);
+    final path=Path()..moveTo(l,b);
+    // Approved illustrative R-O2 points, no replacement calculation engine.
+    for(final (x,y) in [(0.0,0.0),(0.25,0.7071),(0.5,1.0),(1.0,1.4142)]) {
+      path.lineTo(l+w*x,b-h*y/1.5);
+    }
+    canvas.drawPath(path,paint);
+    void text(String s,double x,double y) {
+      final p=TextPainter(text:TextSpan(text:s,style:TextStyle(fontFamily:'Roboto',fontSize:12,color:c)),textDirection:TextDirection.ltr)..layout();
+      p.paint(canvas,Offset(x,y));
+    }
+    text('1×',0,b-h/1.5-8);text('0',l,b+8);text('5 h · plan',l+w*0.4,b+8);text('10 h',l+w-25,b+8);
+  }
+  @override bool shouldRepaint(covariant CustomPainter old)=>false;
+}
+class NightBarPainter extends CustomPainter {
+  const NightBarPainter(this.palette);
+  final AppPalette palette;
+  @override void paint(Canvas canvas,Size size) {
+    final paint=Paint()..style=PaintingStyle.fill;
+    final w=size.width;void bar(double top,double a,double b,Color color) {paint.color=color;canvas.drawRect(Rect.fromLTWH(w*a,top,w*(b-a),16),paint);}
+    bar(8,0,1,palette.chartTwilight);bar(8,0.29,0.79,palette.chartDark);
+    bar(34,0,0.486111,palette.chartMoon);bar(60,0.486111,0.791667,palette.chartWindow);
+    paint..color=palette.textPrimary..strokeWidth=1;
+    for(var x=w*0.486111;x<w*0.791667;x+=9) {canvas.drawLine(Offset(x,75),Offset(x+12,60),paint);}
+  }
+  @override bool shouldRepaint(covariant CustomPainter old)=>false;
+}
