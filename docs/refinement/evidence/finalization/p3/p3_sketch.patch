+Object? footerRect(WidgetTester t) {
+  final f=find.byKey(primary);if(f.evaluate().isEmpty)return null;
+  final r=t.getRect(f);return {'left':r.left,'top':r.top,'right':r.right,'bottom':r.bottom};
