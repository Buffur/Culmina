+import 'package:astroplan/domain/services/exposure_input.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('F06 A5: out-of-range fraction must produce a field problem', () {
+    expect(ExposureInput.problem('18446744073709551616/1'), isNotNull);
+  });
+  test('F06 A5: large denominator must not throw in a field validator', () {
+    expect(ExposureInput.problem('1/18446744073709551616'), isNotNull);
+  });
+}
diff --git a/build/finalization/develop_review_20261019/external_probe_test.dart b/build/finalization/develop_review_20261019/external_probe_test.dart
new file mode 100644
--- /dev/null
+++ b/build/finalization/develop_review_20261019/external_probe_test.dart
@@ -0,0 +1,58 @@
+import 'dart:io';
+import 'package:astroplan/core/time/clock.dart';
+import 'package:astroplan/data/metadata/file_metadata_source.dart';
+import 'package:astroplan/data/repositories/open_meteo_weather_repository.dart';
+import 'package:astroplan/domain/metadata/capture_metadata_reader.dart';
+import 'package:astroplan/domain/metadata/capture_metadata.dart';
+import 'package:astroplan/domain/metadata/metadata_source.dart';
+import 'package:astroplan/domain/models/camera_class.dart';
+import 'package:astroplan/domain/models/capture_block.dart';
+import 'package:astroplan/domain/models/weather_snapshot.dart';
+import 'package:astroplan/domain/services/block_proposal.dart';
+import 'package:astroplan/domain/services/storage_estimate.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  test('G1: live public-site forecast through production repository', () async {
+    final now = DateTime.utc(2026,10,19,14);
+    final result = await OpenMeteoWeatherRepository(clock: FixedClock(now)).fetchSnapshot(
+      latitude: 46.05, longitude: 14.51,
+      startUtc: now, endUtc: now.add(const Duration(days: 1)),
+    );
+    expect(result, isA<WeatherFetched>());
+    final snapshot = (result as WeatherFetched).snapshot;
+    expect(snapshot.hours.length, 384);
+    expect(snapshot.hours.first.timeUtc.isUtc, isTrue);
+    // ignore: avoid_print
+    print('REVIEW_LIVE_FORECAST hours=${snapshot.hours.length} source=${snapshot.source}');
+  });
+  Future<BlockProposal> fromFits() async {
+    final file = File('build/finalization/develop_review_20261019/a8280271.fits');
+    final source = BudgetedMetadataSource(await FileMetadataSource.open(file));
+    try {
+      final reading = await CaptureMetadataReader.read(source);
+      expect(reading, isA<MetadataRead>());
+      return BlockProposal.of(name: 'a8280271.fits', reading: reading,
+        lengthBytes: await file.length(), cameraClass: CameraClass.astroMono);
+    } finally { await source.close(); }
+  }
+  test('F10 A3 partial: public telescope FITS reader, proposal, measured storage', () async {
+    final p = await fromFits();
+    expect(p.exposure!.value, 150.040);
+    expect(p.file!.width, 536);
+    expect(p.file!.height, 520);
+    final block = CaptureBlock(frameType: FrameType.light,
+      exposureTimeSeconds: p.exposure!.value, frameCount: 1, fileEvidence: p.file);
+    final storage = StorageEstimate.of(block, null);
+    expect(storage.basis, StorageBasis.blockFile);
+    expect(storage.bytes, 561600);
+  });
+  test('F10 A2: a FITS GAIN explicitly in electrons per ADU is not acquisition gain', () async {
+    final p = await fromFits();
+    // In the real public header GAIN = 1.9 / e-/ADU. This is a conversion
+    // factor, not a camera-driver acquisition setting (SI-004).
+    // ignore: avoid_print
+    print('REVIEW_FITS_GAIN proposedAcquisitionGain=${p.gain?.value.value}');
+    expect(p.gain, isNull, reason: 'Conversion e-/ADU must not be proposed as driver gain');
+  });
+}
