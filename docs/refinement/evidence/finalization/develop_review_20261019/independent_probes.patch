diff --git a/build/finalization/develop_review_20261019/cleanup_probe_test.dart b/build/finalization/develop_review_20261019/cleanup_probe_test.dart
new file mode 100644
--- /dev/null
+++ b/build/finalization/develop_review_20261019/cleanup_probe_test.dart
@@ -0,0 +1,71 @@
+// Independent review: reachable crash snapshot at successful restore cleanup.
+import 'dart:io';
+
+import 'package:astroplan/data/backup/backup_staging.dart';
+import 'package:astroplan/data/database/app_database.dart';
+import 'package:astroplan/domain/services/backup_service.dart';
+import 'package:drift/native.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:path/path.dart' as p;
+import 'package:shared_preferences/shared_preferences.dart';
+
+class _Death extends Error {}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  test('F01 A3: committed restore cleanup must preserve backup selection on restart', () async {
+    final dir = await Directory.systemTemp.createTemp('culmina_f01_cleanup_review_');
+    final live = File(p.join(dir.path, BackupStaging.database));
+    Future<void> make(File f, int id) async {
+      final db = AppDatabase(NativeDatabase(f));
+      try {
+        await db.customStatement(
+          'INSERT INTO location_profiles (id,name,latitude,longitude,elevation,time_zone) '
+          "VALUES (?, 'Review site', 46.05, 14.51, 300, 'Europe/Ljubljana')",
+          [id],
+        );
+      } finally { await db.close(); }
+    }
+    Future<(int,int?)> pair() async {
+      final db = AppDatabase(openDatabaseConnection(() async => live));
+      try {
+        final row = await db.customSelect('SELECT id FROM location_profiles').getSingle();
+        return (row.read<int>('id'), (await SharedPreferences.getInstance()).getInt('activeLocationId'));
+      } finally { await db.close(); }
+    }
+    try {
+      SharedPreferences.setMockInitialValues({'activeLocationId': 1});
+      await make(live, 1);
+      final backup = File(p.join(dir.path, 'source.sqlite'));
+      await make(backup, 2);
+      await BackupStaging.stage(dir, await backup.readAsBytes(), preferences: {
+        'version': 1, 'bool': <String,bool>{},
+        'int': <String,int>{'activeLocationId': 2},
+        'double': <String,double>{}, 'string': <String,String>{},
+      });
+      final now = DateTime.utc(2026,10,19,12);
+      await expectLater(BackupStaging.apply(dir, nowUtc: now, onStep: (step) async {
+        if (step == 'commit') throw _Death();
+      }), throwsA(isA<_Death>()));
+      expect(await pair(), (2,2));
+      // Materialize precisely the next reachable on-disk state in production:
+      // _writeOutcome(applied) completed, stagedPreferences deleted, journal
+      // not deleted yet. There is no onStep hook at this cleanup boundary.
+      await File(p.join(dir.path, BackupStaging.outcomeFile)).writeAsString('{"result":"applied"}', flush: true);
+      await File(p.join(dir.path, BackupStaging.stagedPreferences)).delete();
+      expect(File(p.join(dir.path, BackupStaging.journal)).existsSync(), isTrue);
+      final outcome = await BackupStaging.apply(dir, nowUtc: now.add(const Duration(minutes: 1)));
+      final observed = await pair();
+      // ignore: avoid_print
+      print('REVIEW_F01_CLEANUP result=${outcome?.result.name} databaseSite=${observed.$1} selectedSite=${observed.$2}');
+      expect(observed, (2,2), reason: 'A completed restore must keep the backup selection after cleanup interruption');
+    } finally {
+      final target = dir.resolveSymbolicLinksSync();
+      final root = Directory.systemTemp.resolveSymbolicLinksSync();
+      if (!p.isWithin(root,target) || !p.basename(target).startsWith('culmina_f01_cleanup_review_')) {
+        throw StateError('Unexpected probe cleanup target');
+      }
+      await dir.delete(recursive: true);
+    }
+  });
+}
