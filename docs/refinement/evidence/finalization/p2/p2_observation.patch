+class Forecast implements WeatherRepository {
+  bool unavailable = false;
+  bool partial = false;
+  int ageHours = 0;
+  @override
+  Future<WeatherFetch> fetchSnapshot({required double latitude,
+    required double longitude, required DateTime startUtc,
+    required DateTime endUtc}) async {
+    if (unavailable) return const WeatherFetchFailed(WeatherFailure.unavailable);
+    final first = DateTime.utc(startUtc.year, startUtc.month, startUtc.day,
+      startUtc.hour);
+    return WeatherFetched(WeatherSnapshot(provider: 'open-meteo',
+      model: 'best_match', fetchedAtUtc: DateTime.utc(2026, 12, 15, 17)
+        .subtract(Duration(hours: ageHours)), latitude: latitude,
+      longitude: longitude, hours: [
+        for (var t = first; t.isBefore(endUtc); t = t.add(const Duration(hours: 1)))
+          WeatherHour(timeUtc: t, cloudCoverPct: partial && t.hour.isOdd ? null : 40,
+            cloudCoverLowPct: 10, cloudCoverMidPct: 20, cloudCoverHighPct: 40,
+            precipitationProbabilityPct: 5, windSpeedKmh: 8, windGustsKmh: 15,
+            temperatureC: 2, dewPointC: -3, relativeHumidityPct: 70,
+            visibilityM: 24000),
+      ]));
+  }
+}
