+Future<void> capture(WidgetTester t, String name, {Map<String,Object?> extra = const {}}) async {
+  final errors = <String>[];
+  Object? error;
+  while ((error = t.takeException()) != null) { errors.add(error.toString()); }
+  final paragraphs = t.renderObjectList<RenderParagraph>(
+    find.byWidgetPredicate((w) => w is RichText)).toList();
+  final families = <String>{for (final r in paragraphs)
+    r.text.style?.fontFamily ?? '<inherited/unspecified>'};
+  final visibleText = t.widgetList<Text>(find.byType(Text))
+    .map((w) => w.data ?? w.textSpan?.toPlainText() ?? '').toList();
+  final scrolls = t.stateList<ScrollableState>(find.byType(Scrollable))
+    .where((s) => s.position.hasContentDimensions)
+    .map((s) => {'axis': s.axisDirection.name,
+      'maxScrollExtent': s.position.maxScrollExtent,
+      'pixels': s.position.pixels}).toList();
+  final boundary = t.renderObject<RenderRepaintBoundary>(find.byKey(shot));
+  await work(t, () async {
+    final im = await boundary.toImage();
+    final png = await im.toByteData(format: ui.ImageByteFormat.png);
+    im.dispose();
+    await File('$out/$name.png').writeAsBytes(png!.buffer.asUint8List());
+  });
+  observations.add({'name':name,'evidence':'HOST RENDER / TEST EXECUTED',
+    'viewport':'412x915, DPR1','textScale':t.platformDispatcher.textScaleFactor,
+    'simulatedKeyboardInset':t.view.viewInsets.bottom,
+    'fontFamilies':families.toList(),'frameworkExceptions':errors,
+    'textInBuiltTree':visibleText,'scrolls':scrolls,...extra});
+  print('P2_CAPTURE $name exceptions=${errors.length}');
+  await t.runAsync(() async => File('$out/observations.json').writeAsString(const JsonEncoder.withIndent('  ').convert(observations)));
+}
