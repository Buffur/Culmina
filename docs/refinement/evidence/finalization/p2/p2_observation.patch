+class BackupDouble implements BackupService {
+  bool staged = false;
+  BackupProblem? refuse;
+  @override
+  Future<void> backUpAndShare() async {}
+  @override
+  Future<({BackupPreview preview, Object file})?> pick() async {
+    if (refuse != null) throw BackupException(refuse!);
+    return (preview: BackupPreview(createdAtUtc: DateTime.utc(2026, 10, 12, 18),
+      schemaVersion: 25, appVersion: '1.0.0', sessionCount: 1), file: 'synthetic');
+  }
+  @override
+  Future<void> stage(Object file) async => staged = true;
+  @override
+  Future<bool> hasStagedRestore() async => staged;
+  @override
+  Future<void> cancelStagedRestore() async => staged = false;
+}
