+ThemeData realFont(ThemeData t) => t.copyWith(
+  textTheme: t.textTheme.apply(fontFamily: 'Roboto'),
+  primaryTextTheme: t.primaryTextTheme.apply(fontFamily: 'Roboto'),
+  appBarTheme: t.appBarTheme.copyWith(
+    titleTextStyle: t.appBarTheme.titleTextStyle?.copyWith(fontFamily: 'Roboto')));
+
+Future<void> settle(WidgetTester t) async {
+  for (var i = 0; i < 8; i++) {
+    await t.runAsync(() => Future<void>.delayed(Duration.zero));
+    await t.pump(const Duration(milliseconds: 100));
+  }
+}
+
+// Pump both fake-zone callbacks and the real event loop; never await a fake-zone
+// autosave chain only from runAsync after mounting the app.
+Future<void> work(WidgetTester t, Future<void> Function() action) async {
+  var done = false; Object? failure; StackTrace? trace;
+  await t.runAsync(() async {
+    action().then((_) { done = true; }, onError:(Object e, StackTrace st) {
+      failure=e; trace=st; done=true;
+    });
+  });
+  for(var i=0; i<300 && !done; i++) {
+    await t.pump(const Duration(milliseconds:20));
+    await t.runAsync(() => Future<void>.delayed(const Duration(milliseconds:5)));
+  }
+  if(!done) throw StateError('P2 harness work did not settle in 300 pump cycles');
+  if(failure!=null) Error.throwWithStackTrace(failure!,trace!);
+}
