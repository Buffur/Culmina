+// Isolated review probe, not an application change or permanent regression.
+import 'dart:io';
+
+import 'package:astroplan/data/backup/backup_preferences.dart';
+import 'package:astroplan/data/backup/backup_staging.dart';
+import 'package:astroplan/data/database/app_database.dart';
+import 'package:astroplan/domain/services/backup_service.dart';
+import 'package:drift/native.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:path/path.dart' as p;
+import 'package:shared_preferences/shared_preferences.dart';
+
+class _ProcessDeath extends Error {}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  final now = DateTime.utc(2026, 10, 18, 12);
+  late Directory dir;
+  late File live;
+
+  Future<void> createDatabase(File file, int siteId, String name) async {
+    final db = AppDatabase(NativeDatabase(file));
+    try {
+      await db.customStatement(
+        'INSERT INTO location_profiles '
+        '(id, name, latitude, longitude, elevation, time_zone) '
+        "VALUES (?, ?, 46.05, 14.51, 300, 'Europe/Ljubljana');",
+        [siteId, name],
+      );
+    } finally {
+      await db.close();
+    }
+  }
+
+  Future<(int, int?)> readPair() async {
+    final db = AppDatabase(openDatabaseConnection(() async => live));
+    try {
+      final row = await db.customSelect('SELECT id FROM location_profiles').getSingle();
+      final preferences = await SharedPreferences.getInstance();
+      return (row.read<int>('id'), preferences.getInt('activeLocationId'));
+    } finally {
+      await db.close();
+    }
+  }
+
+  setUp(() async {
+    SharedPreferences.setMockInitialValues({'activeLocationId': 1});
+    dir = await Directory.systemTemp.createTemp('culmina_f01_review_');
+    live = File(p.join(dir.path, BackupStaging.database));
+    await createDatabase(live, 1, 'Original site');
+    final source = File(p.join(dir.path, 'review-source.sqlite'));
+    await createDatabase(source, 2, 'Backup site');
+    await BackupStaging.stage(dir, await source.readAsBytes(), preferences: {
+      'version': 1,
+      'bool': <String, bool>{},
+      'int': <String, int>{'activeLocationId': 2},
+      'double': <String, double>{},
+    });
+    await source.delete();
+  });
+
+  tearDown(() async {
+    final root = Directory.systemTemp.resolveSymbolicLinksSync();
+    final target = dir.resolveSymbolicLinksSync();
+    if (!p.isWithin(root, target) || !p.basename(target).startsWith('culmina_f01_review_')) {
+      throw StateError('Unexpected probe cleanup target');
+    }
+    await dir.delete(recursive: true);
+  });
+
+  test('control: an activation I/O failure rolls back a coherent old pair', () async {
+    final outcome = await BackupStaging.apply(
+      dir,
+      nowUtc: now,
+      onStep: (step) async {
+        if (step == 'preferences') throw const FileSystemException('injected activation failure');
+      },
+    );
+    expect(outcome!.result, RestoreResult.refused);
+    expect(await readPair(), (1, 1));
+  });
+
+  test('F01 A3: process death during rollback must remain coherent after restart', () async {
+    await expectLater(
+      BackupStaging.apply(
+        dir,
+        nowUtc: now,
+        onStep: (step) async {
+          if (step == 'preferences') throw const FileSystemException('injected activation failure');
+        },
+        putBackPreferences: (snapshot) async {
+          await BackupPreferences.putBack(snapshot);
+          // Old database and preferences are back, but rollback has not
+          // removed the forward-recovery journal/staged preferences yet.
+          throw _ProcessDeath();
+        },
+      ),
+      throwsA(isA<_ProcessDeath>()),
+    );
+    expect(await readPair(), (1, 1));
+    expect(File(p.join(dir.path, BackupStaging.journal)).existsSync(), isTrue);
+    final resumed = await BackupStaging.apply(dir, nowUtc: now.add(const Duration(minutes: 1)));
+    final pair = await readPair();
+    // Surface the actual observation even if the invariant assertion fails.
+    // ignore: avoid_print
+    print('REVIEW_F01_ROLLBACK_RESUME result=${resumed?.result.name} '
+        'databaseSite=${pair.$1} selectedSite=${pair.$2}');
+    expect(pair == (1, 1) || pair == (2, 2), isTrue,
+        reason: 'Restore restart must leave either the old DB/settings or the new DB/settings, never mixed');
+  });
+}
