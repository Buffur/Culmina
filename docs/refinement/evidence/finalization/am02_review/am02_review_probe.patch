+/// Planning preferences whose writes can fail or wait for the test.
+class ControlledPreferences implements PlanningPreferencesRepository {
+  PlanningPreferences durable = PlanningPreferences();
+  bool fail = false;
+  bool hold = false;
+  final gates = <Completer<void>>[];
+
+  @override
+  Future<PlanningPreferences> load() async => durable;
+
+  @override
+  Future<void> save(PlanningPreferences preferences) async {
+    if (hold) {
+      final gate = Completer<void>();
+      gates.add(gate);
+      await gate.future;
+    }
+    if (fail) throw const StorageFailure('save the planning preferences');
+    durable = preferences;
+  }
+}
