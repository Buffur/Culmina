+Future<(AppDatabase, PlannerHarness)> harness(
+  WidgetTester t, {
+  LocationService? location,
+}) async {
+  late AppDatabase db;
+  late PlannerHarness vm;
+  await work(t, () async {
+    db = AppDatabase(NativeDatabase.memory());
+    final targets = DriftTargetRepository(db);
+    final rigs = DriftEquipmentRepository(db);
+    await targets.insertTarget(
+      const AstroTarget(
+        id: 1,
+        catalogId: 'M42',
+        commonName: 'Orion Nebula',
+        type: 'Nebula',
+        rightAscension: 83.82,
+        declination: -5.39,
+      ),
+    );
+    await rigs.insertEquipment(
+      const EquipmentProfile(
+        id: 1,
+        name: 'Fixture refractor 400',
+        cameraClass: CameraClass.dslrMirrorless,
+        focalRatio: 5,
+        focalLengthMm: 400,
+        sensorWidthMm: 23.5,
+        sensorHeightMm: 15.6,
+        resolutionWidthPx: 6000,
+        resolutionHeightPx: 4000,
+        pixelPitchUm: 3.76,
+        averageRawFileSizeMB: 50,
+      ),
+    );
+    final clock = FixedClock(DateTime.utc(2026, 12, 15, 17));
+    vm = PlannerHarness(
+      targets,
+      rigs,
+      NoWeather(),
+      DriftLocationRepository(db),
+      locationService: location ?? ControlledLocation(),
+      reverseGeocoder: FakeReverseGeocoder(),
+      deviceTimeZone: FakeDeviceTimeZone('Europe/Ljubljana'),
+      clock: clock,
+      sessionRepository: DriftSessionRepository(db, clock: clock),
+      firstRun: InMemoryFirstRun(done: true),
+    );
+    await vm.ready;
+    await vm.tonight.load();
+    await vm.site.setLocation(46.05, 14.5);
+    await vm.plan.idle;
+    await vm.conditions.idle;
+  });
+  addTearDown(() => t.runAsync(db.close));
+  return (db, vm);
+}
