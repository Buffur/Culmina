+/// An in-memory platform store that throws while writing one key.
+class TearingStore extends InMemorySharedPreferencesStore {
+  TearingStore(super.data) : super.withData();
+  String? failKey;
+
+  @override
+  Future<bool> setValue(String valueType, String key, Object value) {
+    if (key == failKey) {
+      return Future.error(PlatformException(code: 'write-failed'));
+    }
+    return super.setValue(valueType, key, value);
+  }
+}
