+/// Every search waits until the test completes its query's completer.
+class ControlledTargets implements TargetRepository {
+  final pending = <String, Completer<List<AstroTarget>>>{};
+  final calls = <String>[];
+
+  @override
+  Future<List<AstroTarget>> searchTargets(String query) {
+    calls.add(query);
+    return (pending[query] = Completer<List<AstroTarget>>()).future;
+  }
+
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
