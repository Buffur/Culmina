+class FailingPrivacy extends InMemoryPrivacyPreferences {
+  FailingPrivacy() : super(placeNameLookup: true);
+  bool fail = false;
+
+  @override
+  Future<void> savePlaceNameLookup(bool on) async {
+    if (fail) throw const StorageFailure('save the place-name setting');
+    await super.savePlaceNameLookup(on);
+  }
+}
