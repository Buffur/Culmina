+void record(String id, Map<String, Object?> facts) {
+  observations.add({'id': id, ...facts});
+  // ignore: avoid_print
+  print('AM02_OBSERVATION $id ${jsonEncode(facts)}');
+  Directory(out).createSync(recursive: true);
+  File(
+    '$out/observations.json',
+  ).writeAsStringSync(const JsonEncoder.withIndent('  ').convert(observations));
