### Ran Playwright code
```js
await (// Run through the pinned Playwright CLI, after opening/snapshotting the adapter.
// This only normalizes the preview host frame to the Flutter host canvas.
async (page) => {
  const base = 'http://127.0.0.1:4174/conditions.html';
  const output = 'docs/design/migration/evidence/matched';
  const framing = `
    .planner-page>.lab-toolbar,.planner-page>.plan-preview-bar,.skip-link{display:none!important}
    .planner-page{padding:0!important;margin:0!important}
    .planner-page>.android-device{width:412px!important;height:915px!important;min-height:915px!important;max-height:915px!important;flex:none!important;margin:0!important;border:0!important;border-radius:0!important}
    .android-statusbar,.android-gesture{display:none!important}
  `;
  await page.setViewportSize({ width: 412, height: 915 });
  const records = [];
  for (const theme of ['light', 'dark', 'field']) {
    for (const scale of ['1', '2']) {
      for (const view of ['night', 'moon', 'weather']) {
        const url = `${base}?variant=blend&font=Geist&night=2026-11-10&view=${view}&theme=${theme}&scale=${scale}`;
        await page.goto(url);
        await page.locator('#viewed-night').waitFor();
        await page.evaluate(() => document.fonts.ready);
        await page.addStyleTag({ content: framing });
        const name = `browser-${view}-${theme}${scale === '1' ? '100' : '200'}.png`;
        await page.getByRole('region', { name: 'Android phone preview' }).screenshot({ path: `${output}/${name}`, scale: 'css' });
        records.push(await page.evaluate(({ name, url }) => ({
          name, url, viewport: [innerWidth, innerHeight],
          frame: document.querySelector('.android-device').getBoundingClientRect().toJSON(),
          font: getComputedStyle(document.querySelector('.android-device')).fontFamily,
          fontLoaded: document.fonts.check('16px Geist'),
          bodyOverflow: document.documentElement.scrollWidth > innerWidth,
          scale: getComputedStyle(document.documentElement).getPropertyValue('--text-scale'),
        }), { name, url }));
        if (view === 'weather') {
          await page.locator('.hourly-section').evaluate(element =>
            element.scrollIntoView({ block: 'start', behavior: 'instant' }));
          const charts = `browser-weather-charts-${theme}${scale === '1' ? '100' : '200'}.png`;
          await page.getByRole('region', { name: 'Android phone preview' }).screenshot({ path: `${output}/${charts}`, scale: 'css' });
          records.push({ name: charts, url, view: 'hourly section start' });
        }
      }
    }
  }
  return { capturedAtUtc: new Date().toISOString(), framing, records };
}
)(page);
