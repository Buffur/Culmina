### Ran Playwright code
```js
await (async (page) => {
 const roots = ['tonight','plan','night','moon','weather','logbook','library','settings'];
 const manifest=[];
 for (const theme of ['light','dark','field']) {
  for (const root of roots) {
   const file=root==='tonight'?'index.html':root==='plan'?'plan.html':['night','moon','weather'].includes(root)?'conditions.html':'workspace.html';
   const query=new URLSearchParams({variant:'blend',theme,font:'Geist',scale:'1',scenario:'ready'});
   if(root==='tonight')query.set('view','wide'); else if(['night','moon','weather'].includes(root))query.set('view',root); else if(root!=='plan')query.set('tab',root);
   await page.setViewportSize({width:412,height:915});
   await page.goto('http://127.0.0.1:4173/'+file+'?'+query+(root==='tonight'?'#concepts':''));
   await page.evaluate(()=>document.fonts.ready);
   const phone=page.locator('.android-device:visible,.app-frame:visible').first();
   await phone.waitFor();
   const filename='docs/design/migration/evidence/reference/'+root+'-geist-'+theme+'.png';
   await phone.screenshot({path:filename,animations:'disabled'});
   manifest.push({root,theme,url:page.url(),file:filename,box:await phone.boundingBox()});
  }
 }
 console.log(JSON.stringify(manifest));
})(page);
```
### Page
- Page URL: http://127.0.0.1:4173/workspace.html?variant=blend&theme=field&font=Geist&scale=1&scenario=ready&tab=settings
- Page Title: Culmina · Android prototype
